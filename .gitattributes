# Texto con fin de línea normalizado
* text=auto eol=lf
*.cs text diff=csharp
*.json text
*.md text
*.asmdef text

# Archivos YAML de Unity: fusión inteligente si se configura UnityYAMLMerge
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.mat text merge=unityyamlmerge eol=lf
*.anim text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta text eol=lf

# Binarios (cuando llegue el arte conviene activar Git LFS para estos)
*.png binary
*.jpg binary
*.psd binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.pdf binary
